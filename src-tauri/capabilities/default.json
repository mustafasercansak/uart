{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capabilities for UART Simulator",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "shell:default",
    "updater:default",
    "updater:allow-check",
    "updater:allow-install",
    "updater:allow-download-and-install",
    "process:allow-restart"
  ]
}
