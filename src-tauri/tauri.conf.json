{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UART Simulator",
  "version": "1.5.10",
  "identifier": "com.uart.simulator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "UART Simulator",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "RWTtLmyWk0Fceiewa5OJMWJB2leHh1gjACLfeBkdRZeycblJr0Ng5er",
      "endpoints": [
        "https://github.com/mustafasercansak/uart/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
