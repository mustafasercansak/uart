  "learning": {
    "title": "Learning Mode",
    "subtitle": "Step-by-step lessons that teach UART protocols through live simulation data.",
    "done": "✓ DONE",
    "stepsCount": "{count} steps",
    "loadProfileWarning": "⚠ Load a compatible profile first",
    "tip": "Tip:",
    "globalTip": "Start a simulation first, then work through the lessons in order. Each lesson references live data from the running simulation.",
    "backToLessons": "← Lessons",
    "stepProgress": "Step {current} of {total}",
    "byteLayout": "BYTE LAYOUT",
