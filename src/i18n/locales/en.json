    "fieldNotFound": "Field \"{field}\" not found in active profile.",
    "startSimulationPrompt": "Start the simulation to see live values.",
    "currentFrameHex": "CURRENT FRAME HEX",
    "watchingCondition": "Watching for condition — will auto-advance when met",
    "back": "← BACK",
    "next": "NEXT →",
    "completeLesson": "✓ COMPLETE LESSON",
    "lessons": {
      "uartBasics": {
        "title": "How UART Works",
        "desc": "Understand the byte-by-byte structure of a serial UART frame.",
        "steps": {
          "start": {
            "title": "What is UART?",
            "explanation": "UART stands for Universal Asynchronous Receiver-Transmitter. It is the most common serial protocol used in medical devices, sensors, and industrial equipment. Both sides agree on a speed (baud rate) and then exchange data one byte at a time.",
            "tip": "Start the simulation and watch the Frame Monitor — each row is one UART transmission."
          },
          "anatomy": {
            "title": "Anatomy of a Frame",
            "explanation": "Every UART transmission follows a fixed structure: a START bit (logic LOW), then 8 data bits (LSB first), an optional PARITY bit for error detection, and finally a STOP bit (logic HIGH). The \"frame\" in this simulator is a packet of multiple bytes sent together.",
            "byteAnnotation": "START | D0 D1 D2 D3 D4 D5 D6 D7 | PARITY | STOP",
            "tip": "Open the Logic Analyzer tab to see individual bit transitions for each byte."
          },
          "baud": {
            "title": "Baud Rate = Speed",
            "explanation": "The baud rate defines how many symbols per second are transmitted. At 9600 baud, each bit lasts ~104 µs. At 115200 baud, each bit lasts ~8.7 µs. Both sides must use the same baud rate — even a 1% mismatch causes framing errors.",
            "tip": "Change the baud rate in the Profile Editor and watch how the Logic Analyzer bit widths change."
          },
          "checksum": {
            "title": "Error Detection with Checksums",
            "explanation": "Medical devices add a checksum byte at the end of each frame. The receiver independently calculates the checksum from the received bytes. If it does not match, the frame is rejected. Common algorithms: XOR, Sum-Mod-256, CRC8, CRC16-CCITT.",
            "tip": "Use the Error Injection panel to corrupt the checksum and watch the receiver reject the frame."
          }
        }
      },
      "patientMonitor": {
        "title": "Patient Monitor Deep Dive",
        "desc": "Learn how a bedside patient monitor encodes and transmits vital signs over UART.",
        "steps": {
          "intro": {
            "title": "The Patient Monitor",
            "explanation": "A patient monitor continuously measures and displays vital signs: heart rate (ECG), blood oxygen saturation (SpO₂), respiratory rate, and temperature. All of these are digitised and packed into a UART frame that is transmitted every 40–100 ms.",
            "tip": "Click the Patient Monitor in the 3D view to see its live values."
          },
          "heartRate": {
            "title": "Heart Rate Byte",
            "explanation": "The BPM (beats per minute) value is stored as a single byte (0–255). A value of 75 is encoded as 0x4B. The receiver reads this byte, validates it is within physiological range (typically 30–250 BPM), and displays it. Values outside range trigger an alarm flag in the status byte.",
            "byteAnnotation": "75 BPM → 0x4B",
            "tip": "Watch the BPM field in the Frame Monitor as the simulation runs."
          },
          "spo2": {
            "title": "SpO₂ Byte",
            "explanation": "Blood oxygen saturation is sent as a percentage (0–100). A healthy value like 98% is encoded as 0x62. If the value drops below 90%, the alarm byte flips bit 1, and the monitor sounds an audible alert. The 3D patient monitor will also turn red.",
            "byteAnnotation": "98% SpO₂ → 0x62",
            "tip": "Use the Error Injection panel to simulate a \"Low SpO₂\" event and watch the 3D alarm ring appear."
          },
          "ecg": {
            "title": "ECG Waveform Samples",
            "explanation": "In addition to the numeric BPM, the monitor transmits raw ECG waveform samples at 250 Hz. Each sample is a 12-bit value (0–4095) stored in 2 bytes (big-endian). The receiver renders these into the characteristic PQRST waveform you see on hospital screens.",
            "byteAnnotation": "ECG sample 2048 → 0x08 0x00 (big-endian)",
            "tip": "Open the Waveforms tab to see the live ECG reconstruction from these bytes."
          }
        }
      },
      "signalIntegrity": {
        "title": "Signal Integrity & Noise",
        "desc": "Explore what happens to UART data when the electrical signal degrades.",
        "steps": {
          "perfect": {
            "title": "A Perfect Signal",
            "explanation": "In ideal conditions, a UART TX line sits at logic HIGH (e.g., +3.3V or +5V) between frames. Each bit transition is sharp and clean. The receiver samples the line at the center of each bit period, so small timing variations do not matter.",
            "tip": "In the Signal Integrity panel, set noise and jitter to zero and observe the Logic Analyzer."
          },
          "noise": {
            "title": "Electrical Noise",
            "explanation": "Real cables pick up electromagnetic interference (EMI) from nearby motors, power lines, or radio signals. This corrupts individual bits — a 1 becomes a 0 or vice versa. The result: framing errors or wrong data values. UART has no built-in retry mechanism, which is why checksums are critical.",
            "tip": "Increase the Noise Level slider in Signal Integrity and watch the error count climb in the Status Bar."
          },
          "jitter": {
            "title": "Clock Jitter",
            "explanation": "Jitter is timing uncertainty — the bit edges arrive slightly early or late. Since both sides run independent clocks (asynchronous!), any frequency mismatch compounds over the 10 bits in a frame. Excessive jitter causes the receiver to sample the wrong bit. Maximum tolerance is typically ±2–3%.",
            "tip": "Enable Bit Flip in Signal Integrity and watch random bytes get corrupted in the Frame Monitor."
          },
          "solutions": {
            "title": "Engineering Solutions",
            "explanation": "Engineers use hardware solutions (shielded cables, twisted pairs, RS-422/485 differential signalling) and software solutions (CRC checksums, retransmission, redundant sensors) to handle real-world signal degradation. In critical medical devices, all of these are required simultaneously.",
            "tip": "Try enabling all three signal integrity options at once and observe how quickly the system degrades."
          }
        }
      }
    }
