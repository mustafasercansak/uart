    "completeLesson": "✓ DERSİ TAMAMLA",
    "lessons": {
      "uartBasics": {
        "title": "UART Nasıl Çalışır?",
        "desc": "Bir seri UART paketinin bayt bayt yapısını anlayın.",
        "steps": {
          "start": {
            "title": "UART Nedir?",
            "explanation": "UART, Evrensel Asenkron Alıcı-Verici anlamına gelir. Tıbbi cihazlarda, sensörlerde ve endüstriyel ekipmanlarda kullanılan en yaygın seri protokoldür. Her iki taraf da bir hız (baud hızı) üzerinde anlaşır ve ardından her seferinde bir bayt veri alışverişi yapar.",
            "tip": "Simülasyonu başlatın ve Frame Monitor'ü izleyin — her satır bir UART iletimidir."
          },
          "anatomy": {
            "title": "Bir Paketin Anatomisi",
            "explanation": "Her UART iletimi sabit bir yapıyı takip eder: bir BAŞLAT biti (lojik DÜŞÜK), ardından 8 veri biti (önce LSB), hata tespiti için isteğe bağlı bir PARİTE biti ve son olarak bir DURDUR biti (lojik YÜKSEK). Bu simülatördeki \"paket\", birlikte gönderilen birden fazla bayttan oluşan bir gruptur.",
            "byteAnnotation": "START | D0 D1 D2 D3 D4 D5 D6 D7 | PARITY | STOP",
            "tip": "Her bayt için ayrı bit geçişlerini görmek için Lojik Analizör sekmesini açın."
          },
          "baud": {
            "title": "Baud Hızı = Hız",
            "explanation": "Baud hızı, saniyede kaç sembolün iletildiğini tanımlar. 9600 baud hızında, her bit ~104 µs sürer. 115200 baud hızında, her bit ~8.7 µs sürer. Her iki taraf da aynı baud hızını kullanmalıdır — %1'lik bir uyumsuzluk bile paketleme hatalarına neden olur.",
            "tip": "Profil Düzenleyici'de baud hızını değiştirin ve Lojik Analizör bit genişliklerinin nasıl değiştiğini izleyin."
          },
          "checksum": {
            "title": "Checksum ile Hata Tespiti",
            "explanation": "Tıbbi cihazlar, her paketin sonuna bir checksum baytı ekler. Alıcı, alınan baytlardan checksum'ı bağımsız olarak hesaplar. Eğer eşleşmezse, paket reddedilir. Yaygın algoritmalar: XOR, Sum-Mod-256, CRC8, CRC16-CCITT.",
            "tip": "Checksum'ı bozmak için Hata Enjeksiyonu panelini kullanın ve alıcının paketi reddetmesini izleyin."
          }
        }
      },
      "patientMonitor": {
        "title": "Hasta Monitörü İncelemesi",
        "desc": "Bir hasta başı monitörünün hayati belirtileri UART üzerinden nasıl kodlayıp ilettiğini öğrenin.",
        "steps": {
          "intro": {
            "title": "Hasta Monitörü",
            "explanation": "Bir hasta monitörü hayati belirtileri sürekli olarak ölçer ve görüntüler: kalp atış hızı (EKG), kandaki oksijen doygunluğu (SpO₂), solunum hızı ve sıcaklık. Bunların tümü dijitalleştirilir ve her 40–100 ms'de bir iletilen bir UART paketine yerleştirilir.",
            "tip": "Canlı değerlerini görmek için 3D görünümdeki Hasta Monitörü'ne tıklayın."
          },
          "heartRate": {
            "title": "Kalp Atış Hızı Baytı",
            "explanation": "BPM (dakikadaki atış sayısı) değeri tek bir bayt (0–255) olarak saklanır. 75 değeri 0x4B olarak kodlanır. Alıcı bu baytı okur, fizyolojik aralıkta (genellikle 30–250 BPM) olduğunu doğrular ve görüntüler. Aralık dışındaki değerler durum baytında bir alarm bayrağını tetikler.",
            "byteAnnotation": "75 BPM → 0x4B",
            "tip": "Simülasyon çalışırken Frame Monitor'deki BPM alanını izleyin."
          },
          "spo2": {
            "title": "SpO₂ Baytı",
            "explanation": "Kandaki oksijen doygunluğu yüzde (0–100) olarak gönderilir. %98 gibi sağlıklı bir değer 0x62 olarak kodlanır. Değer %90'ın altına düşerse, alarm baytı 1. biti değiştirir ve monitör sesli bir uyarı verir. 3D hasta monitörü de kırmızıya dönecektir.",
            "byteAnnotation": "%98 SpO₂ → 0x62",
            "tip": "Düşük SpO₂ olayını simüle etmek için Hata Enjeksiyonu panelini kullanın ve 3D alarm halkasının görünmesini izleyin."
          },
          "ecg": {
            "title": "EKG Dalga Formu Örnekleri",
            "explanation": "Sayısal BPM'ye ek olarak, monitör 250 Hz'de ham EKG dalga formu örnekleri iletir. Her örnek, 2 baytta (big-endian) saklanan 12 bitlik bir değerdir (0–4095). Alıcı bunları hastane ekranlarında gördüğünüz karakteristik PQRST dalga formuna dönüştürür.",
            "byteAnnotation": "EKG örneği 2048 → 0x08 0x00 (big-endian)",
            "tip": "Bu baytlardan canlı EKG yeniden oluşturulmasını görmek için Dalga Formları sekmesini açın."
          }
        }
      },
      "signalIntegrity": {
        "title": "Sinyal Bütünlüğü ve Gürültü",
        "desc": "Elektriksel sinyal bozulduğunda UART verilerine ne olduğunu keşfedin.",
        "steps": {
          "perfect": {
            "title": "Mükemmel Bir Sinyal",
            "explanation": "İdeal koşullarda, bir UART TX hattı paketler arasında lojik YÜKSEK (örn. +3.3V veya +5V) seviyesinde durur. Her bit geçişi keskin ve temizdir. Alıcı, hattı her bit periyodunun merkezinde örnekler, bu nedenle küçük zamanlama varyasyonları önemli değildir.",
            "tip": "Sinyal Bütünlüğü panelinde gürültü ve titremeyi sıfıra ayarlayın ve Lojik Analizörü gözlemleyin."
          },
          "noise": {
            "title": "Elektriksel Gürültü",
            "explanation": "Gerçek kablolar yakındaki motorlardan, güç hatlarından veya radyo sinyallerinden elektromanyetik girişim (EMI) toplar. Bu, tek tek bitleri bozar — bir 1, 0 olur veya tam tersi. Sonuç: paketleme hataları veya yanlış veri değerleri. UART'ın yerleşik bir yeniden deneme mekanizması yoktur, bu nedenle checksum'lar kritiktir.",
            "tip": "Sinyal Bütünlüğü'nde Gürültü Seviyesi kaydırıcısını artırın ve Durum Çubuğunda hata sayısının yükselmesini izleyin."
          },
          "jitter": {
            "title": "Saat Titremesi (Jitter)",
            "explanation": "Titreme, zamanlama belirsizliğidir — bit kenarları biraz erken veya geç gelir. Her iki taraf da bağımsız saatler çalıştırdığından (asenkron!), herhangi bir frekans uyumsuzluğu bir paketteki 10 bit üzerinde birikir. Aşırı titreme, alıcının yanlış biti örneklemesine neden olur. Maksimum tolerans genellikle ±%2-3'tür.",
            "tip": "Sinyal Bütünlüğü'nde Bit Flip'i etkinleştirin ve Frame Monitor'de rastgele baytların bozulmasını izleyin."
          },
          "solutions": {
            "title": "Mühendislik Çözümleri",
            "explanation": "Mühendisler, gerçek dünyadaki sinyal bozulmasını yönetmek için donanım çözümleri (ekranlı kablolar, bükümlü çiftler, RS-422/485 diferansiyel sinyalleşme) ve yazılım çözümleri (CRC checksum'lar, yeniden iletim, yedekli sensörler) kullanırlar. Kritik tıbbi cihazlarda bunların tümü aynı anda gereklidir.",
            "tip": "Üç sinyal bütünlüğü seçeneğini de aynı anda etkinleştirmeyi deneyin ve sistemin ne kadar çabuk bozulduğunu gözlemleyin."
          }
        }
      }
    }
